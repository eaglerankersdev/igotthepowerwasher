{
 "browser": {
  "mode": "launch",
  "executable_path": "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
  "headless": true
 },
 "start_url": {
  "url": "https://www.igtpw.com/pressure-washing",
  "query": []
 },
 "environment": {
  "viewport": {
   "width": 1440,
   "height": 900,
   "device_scale_factor": 1
  },
  "locale": "en-US",
  "timezone": "America/New_York",
  "color_scheme": "light",
  "reduced_motion": "no-preference",
  "service_workers": "block"
 },
 "actions": [
  {
   "step_id": "settle",
   "action": "wait_for_timeout",
   "duration_ms": 5000
  }
 ],
 "capture": {
  "after_each_step": [],
  "at_end": [
   "url"
  ],
  "events": [
   "network",
   "console"
  ],
  "network": {
   "request_body": false,
   "response_body": false,
   "header_values": false
  }
 }
}